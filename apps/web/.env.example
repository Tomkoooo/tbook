# Copy to .env.local for local development. Never commit the real .env.local.

# Must point at the existing tbook-admin database in production to stay
# backwards compatible with the currently running system.
DATABASE_URL=mongodb://127.0.0.1:27017/tbook-admin-dev

NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production

# Comma-separated origins allowed to call the public v1/v2 API (mirrors the
# legacy TBOOK_API_CORS_ORIGINS).
TBOOK_API_CORS_ORIGINS=http://localhost:3100,http://localhost:3101

# Sign-in is email magic-link only (no OAuth) — sent via the platform SMTP
# config below (also used for voucher/invoice delivery).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=noreply@example.com
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=tBook

# Comma-, semicolon-, or newline-separated emails auto-promoted to system
# admin on their first sign-in. Set at least one so there's a way in.
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_SYSTEM_ADMIN_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
